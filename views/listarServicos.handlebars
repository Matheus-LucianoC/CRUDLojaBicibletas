<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h2>Lista de serviços!</h2>

    <ul>
        {{#each servicos}}
            <li>
                <a href="/servicos/ver/{{id}}">{{nome}}</a>
                <a href="/servicos/{{id}}/editar">editar</a>
                <form action="/servicos/excluir/{{id}}" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('confirma exclusão?')"> 
                        excluir
                    </button>
                </form>
            </li> 
        {{/each}}
    </ul>

    <a href="/homeServicos">Voltar</a>
</body>
</html>