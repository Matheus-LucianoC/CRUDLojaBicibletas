<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h2>Lista de bicicletas, skates, patinetes e afins!</h2>

    <ul>
        {{#each produtos}}
            <li>
                <a href="/bicicletas/ver/{{id}}">{{nome}}</a>
                <a href="/bicicletas/{{id}}/editar">editar</a>
                <form action="/bicicletas/excluir/{{id}}" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('confirma exclusão?')"> 
                        excluir
                    </button>
                </form>
            </li> 
        {{/each}}
    </ul>

    <a href="/homeBicicletas">Voltar</a>
</body>
</html>