<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h2>Editar Pessoa</h2>

    <form action="/pessoas/{{pessoa.id}}/editar" method="post">
        <input type="text" name="pessoa" value="{{pessoa.pessoa}}" required>
        <input type="text" name="senha" value="{{pessoa.senha}}" required>
        <button type="submit">Salvar</button>
    </form>

    <a href="/pessoas">Voltar</a>
</body>
</html>