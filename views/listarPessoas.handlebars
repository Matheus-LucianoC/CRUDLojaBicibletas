<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h2>Lista de Pessoas</h2>

    <ul>
        {{#each pessoas}}
            <li>
                <a href="/pessoas/ver/{{id}}">{{pessoa}}</a>
                <a href="/pessoas/{{id}}/editar">editar</a>
                <form action="/pessoas/excluir/{{id}}" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('confirma exclusão?')"> 
                        excluir
                    </button>
                </form>
            </li> 
        {{/each}}
    </ul>

    <a href="/homePessoas">Voltar</a>
</body>
</html>